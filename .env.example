POSTGRES_DB=lazydeploy
POSTGRES_USER=lazydeploy
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/lazydeploy
DATABASE_USERNAME=lazydeploy
DATABASE_PASSWORD=change-me

# Use true when the application is served through HTTPS.
SESSION_COOKIE_SECURE=false

# Application resource limits (optional tuning values).
DATABASE_MAX_POOL_SIZE=10
DATABASE_MINIMUM_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=600000
DATABASE_MAX_LIFETIME_MS=1800000
MONITORING_EXECUTOR_CORE_POOL_SIZE=4
MONITORING_EXECUTOR_MAX_POOL_SIZE=8
MONITORING_EXECUTOR_QUEUE_CAPACITY=100
MONITORING_EXECUTOR_KEEP_ALIVE_SECONDS=60
SERVER_TOMCAT_THREADS_MAX=50
SERVER_TOMCAT_THREADS_MIN_SPARE=5
SERVER_TOMCAT_MAX_CONNECTIONS=200
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_CONNECTION_TIMEOUT=5s
SHUTDOWN_TIMEOUT=20s

# SMTP timeouts (milliseconds).
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_READ_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
